.search-row { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.search-input { flex: 1; background: var(--muted); border: 2rpx solid var(--border); padding: 12rpx 20rpx; color: var(--foreground); }
.sort-btn { border-color: var(--border); color: var(--muted-fg); font-size: 24rpx; }
.cats { white-space: nowrap; margin-bottom: 20rpx; }
.cat { display: inline-block; border: 2rpx solid var(--border); padding: 8rpx 24rpx; margin-right: 12rpx; color: var(--muted-fg); font-size: 24rpx; }
.cat.active { border-color: var(--primary); color: var(--primary); }
.grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.product { width: calc(50% - 8rpx); box-sizing: border-box; }
.ph { height: 200rpx; background: var(--secondary); display: flex; align-items: center; justify-content: center; margin-bottom: 12rpx; font-weight: 900; color: var(--primary); }
.p-name { font-size: 26rpx; font-weight: 600; line-height: 1.3; }
.p-desc { font-size: 20rpx; margin-top: 4rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.p-price { font-size: 30rpx; margin-top: 8rpx; }
.empty { text-align: center; padding: 80rpx 0; }
.login-bar { display: flex; justify-content: space-between; align-items: center; margin-top: 20rpx; }
