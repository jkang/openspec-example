.line { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.ph { width: 96rpx; height: 96rpx; background: var(--secondary); display: flex; align-items: center; justify-content: center; color: var(--primary); font-weight: 900; }
.mid { flex: 1; }
.nm { font-size: 28rpx; }
.price { margin-top: 6rpx; }
.qty { display: flex; align-items: center; gap: 8rpx; }
.qbtn { border: 2rpx solid var(--border); background: transparent; color: var(--foreground); width: 52rpx; height: 52rpx; line-height: 44rpx; padding: 0; text-align: center; font-size: 30rpx; }
.qn { min-width: 44rpx; text-align: center; }
.rm { border: 2rpx solid var(--border); background: transparent; color: var(--muted-fg); }
.empty { text-align: center; padding: 100rpx 0; }
.total-row { display: flex; justify-content: space-between; align-items: center; }
.total { font-size: 40rpx; }
.checkout { margin-top: 20rpx; width: 100%; }
