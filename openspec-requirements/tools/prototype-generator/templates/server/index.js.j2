// =========================================================
// {{ productName }} · Express 一体化入口
// 开发模式：提供 /api（Vite :{{ devPort }} 代理到此端口）
// 生产模式：NODE_ENV=production 时同时托管前端 dist（单端口一体化）
// =========================================================
import express from 'express';
import cors from 'cors';
import path from 'path';
import { fileURLToPath } from 'url';
import apiRouter from './routes/api.js';
import { config } from './config.js';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const app = express();

app.use(cors());
app.use(express.json({ limit: '10mb' }));

// ---- API 路由 ----
app.use(apiRouter);

// ---- 健康检查 ----
app.get('/api/health', (req, res) => {
  res.json({ status: 'ok', service: config.productName, time: new Date().toISOString() });
});

// ---- 生产模式：托管前端构建产物 ----
const isProd = process.env.NODE_ENV === 'production';
if (isProd) {
  const distDir = path.join(__dirname, '..', 'dist');
  app.use(express.static(distDir));
  app.get('*', (req, res) => {
    if (req.path.startsWith('/api')) {
      return res.status(404).json({ error: 'Not Found' });
    }
    res.sendFile(path.join(distDir, 'index.html'));
  });
}

const PORT = process.env.PORT || config.apiPort;
app.listen(PORT, () => {
  console.log(`[api-server] ${config.productName} API 已启动: http://localhost:${PORT}`);
  if (isProd) {
    console.log('[api-server] 生产模式：前端已托管于同一端口');
  } else {
    console.log(`[api-server] 开发模式：Vite 前端运行于 http://localhost:${config.devPort}（/api 已代理）`);
  }
});
