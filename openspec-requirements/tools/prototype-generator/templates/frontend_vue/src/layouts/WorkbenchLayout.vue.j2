<template>
  <a-layout style="min-height: 100vh">
    <a-layout-sider :width="216" theme="dark" :collapsible="false" style="position: sticky; top: 0; height: 100vh">
      <div class="brand">
        <div class="brand-logo">{{ brand_initial }}</div>
        <div class="brand-text">
          <div class="brand-name">{{ productName }}</div>
          <div class="brand-sub">AI-POWERED MVP</div>
        </div>
      </div>
      <a-menu
        :selected-keys="[route.path]"
        theme="dark"
        @menu-item-click="(key) => router.push(key)"
      >
        <a-menu-item v-for="item in menuItems" :key="item.key">
          <template #icon><component :is="item.icon" /></template>
          {{ '{{ item.label }}' }}
        </a-menu-item>
      </a-menu>
      <div class="brand-foot">
        {{ '{{ persona ? `当前角色：${persona.name}（${persona.role}）` : "" }}' }}
      </div>
    </a-layout-sider>
    <a-layout>
      <a-layout-header class="app-header">
        <div class="header-title">{{ '{{ currentTitle }}' }}</div>
        <div class="header-actions">
          <a-select :model-value="personaId" style="width: 210px" @change="setPersonaId">
            <a-option v-for="p in personas" :key="p.id" :value="p.id">{{ '{{ p.name }}（{{ p.role }}）' }}</a-option>
          </a-select>
          <a-badge :count="3">
            <a-avatar shape="square"><icon-bell /></a-avatar>
          </a-badge>
        </div>
      </a-layout-header>
      <a-layout-content class="app-content">
        <router-view />
      </a-layout-content>
    </a-layout>
  </a-layout>
</template>

<script setup>
import { computed, ref } from 'vue';
import { useRoute, useRouter } from 'vue-router';
import { brand } from '../theme.js';
import { personas } from '../data/appData.js';

const route = useRoute();
const router = useRouter();
const personaId = ref(personas[0]?.id || '');
const persona = computed(() => personas.find((p) => p.id === personaId.value) || personas[0]);

const menuItems = [
{% for page in pages %}
  { key: '{{ page.route }}', label: '{{ page.title }}', icon: '{{ page.icon_arco }}' },
{% endfor %}
];

const currentTitle = computed(() => {
  const found = menuItems.find((m) => m.key === route.path);
  return found ? found.label : '工作台';
});
</script>

