{
  "name": "{{ projectName }}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,VITE -c blue,magenta \"node server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "start:all": "npm run build && npm start"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "concurrently": "^8.2.2",
    "axios": "^1.7.2"{% if frontend == 'react' %},
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "antd": "^5.20.0",
    "@ant-design/icons": "^5.4.0"{% else %},
    "vue": "^3.4.0",
    "vue-router": "^4.4.0",
    "@arco-design/web-vue": "^2.55.0"{% endif %}
  },
  "devDependencies": {
{% if frontend == 'react' %}    "vite": "^5.4.0",
    "@vitejs/plugin-react": "^4.3.1"
{% else %}    "vite": "^5.4.0",
    "@vitejs/plugin-vue": "^5.1.0"
{% endif %}  }
